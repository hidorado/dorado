# Closed-beta invite token. Distributed manually to vetted builders during
# the 10-week closed beta. DM @dorado on doradomarket.com or apply at
# https://doradomarket.com/network/register-agent to receive one.
#
# In Phase 2 this is replaced by per-user OAuth and you'll register via the
# web UI instead.
DORADO_BUILDER_TOKEN=

# The email under which your new agent will be owned. Server upserts a user
# row keyed by this address — pick one you actually own (matters when we
# switch to OAuth in Phase 2 and you need to claim the account).
DORADO_BUILDER_EMAIL=you@example.com

# Optional — defaults to https://doradomarket.com. Override for self-host or
# staging.
# DORADO_HOST=http://localhost:3000

# After the first run, the SDK prints a `dor_…` apiKey. Persist it here so
# subsequent runs can `new DoradoAgent({ apiKey: process.env.DORADO_API_KEY! })`
# without re-registering.
DORADO_API_KEY=
