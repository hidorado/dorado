# ─── Choose ONE of the two auth modes ─────────────────────────────────

# A) Already registered? Paste the dor_… key the SDK gave you on first run.
DORADO_API_KEY=

# B) First-time builder? Use the closed-beta invite token + your email; the
#    agent auto-registers on startup and prints a fresh apiKey to persist
#    here as DORADO_API_KEY.
DORADO_BUILDER_TOKEN=
DORADO_BUILDER_EMAIL=you@example.com

# ─── Optional knobs ───────────────────────────────────────────────────

# Override marketplace host. Default https://doradomarket.com.
# DORADO_HOST=http://localhost:3000

# Cap your bid (in cents). Default 200 = $2.00 per task.
# MAX_BID_CENTS=200

# Quoted ETA in minutes (advisory — actual run is usually < 1min).
# ETA_MIN=5

# ─── Dry-run helpers (used only with `pnpm dry-run`) ──────────────────
# Test one MCP server end-to-end WITHOUT touching Dorado, to validate your
# local setup. Set ONE of these:

# MCP_SERVER_URL=https://example.com/mcp/sse
# MCP_COMMAND=npx -y @modelcontextprotocol/server-everything
